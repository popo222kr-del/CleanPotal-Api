bin/
obj/
*.db
*.db-shm
*.db-wal
.vs/
appsettings.*.local.json
# DB 연결 문자열(비밀번호 포함) — 각 PC/서버 로컬에만 두고 절대 커밋하지 않는다
appsettings.local.json

# frontend
client/node_modules/
client/dist/
.npm-cache/

# 프론트 빌드 결과물이 백엔드 wwwroot로 바로 나옴(단일 사이트 배포용) — 산출물은 커밋하지 않는다
src/CleanPotal.Api/wwwroot/*
!src/CleanPotal.Api/wwwroot/.gitkeep
import/*
!import/.gitkeep

# MES 빌드 산출물 및 로컬 운영 데이터
mes/**/bin/
mes/**/obj/
mes/.build-check/
mes/src/ProductionManagement.Web/App_Data/*
!mes/src/ProductionManagement.Web/App_Data/.gitkeep

# 실수로 딸려 들어왔던 편집기/도구 임시 파일
/package-lock.json
src/CleanPotal.Api/package-lock.json
src/CleanPotal.Api/dispatch_schema.txt

# 로컬 실행 도우미 게시 산출물(소스와 설치 스크립트만 관리)
tools/CleanPotal.FileLauncher/publish/

# 첨부 파일 보관소 (서버에서 만들어진다)
src/CleanPotal.Api/App_Data/

# 표준 로컬 publish 출력(C:\Users\owner\cleanpotal-api\publish) — 배포본이라 커밋하지 않는다
/publish/
