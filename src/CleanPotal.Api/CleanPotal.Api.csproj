<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- 현장 점검 > 온·습도 모니터링. 포털이 Mosquitto 를 직접 구독한다(중간 브리지 없음). -->
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- /mes-runtime → ProductionManagement MES(별도 프로세스) 리버스 프록시.
         개발에서는 Vite dev 서버가 같은 일을 하지만, 운영(IIS 단일 사이트)에는 Vite가 없다.
         이 프록시가 없으면 /mes-runtime 요청이 SPA fallback(index.html)으로 떨어져
         iframe 안에 포털이 다시 열리고, /auth/portal-session 도 HTML 200 을 돌려준다. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanPotal.Infrastructure\CleanPotal.Infrastructure.csproj" />
    <ProjectReference Include="..\CleanPotal.Core\CleanPotal.Core.csproj" />
    <!-- MES 를 포털 안으로 들이는 중이다(3단계: API 노출).
         MES 업무 계층은 화면에 기대지 않는 순수 net10.0 라이브러리라 그대로 쓴다.
         Web(Blazor) 프로젝트는 참조하지 않는다 - 화면은 React 로 옮긴다. -->
    <ProjectReference Include="..\..\mes\src\ProductionManagement.Application\ProductionManagement.Application.csproj" />
    <ProjectReference Include="..\..\mes\src\ProductionManagement.Infrastructure\ProductionManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
