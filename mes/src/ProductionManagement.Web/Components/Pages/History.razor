@page "/history"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ILotHistoryService HistoryService
@inject BarcodeService Barcodes
@inject DbWorkGate Gate
@inject Microsoft.Extensions.Logging.ILogger<History> Logger

<PageTitle>이력 조회</PageTitle>

<PageHeader Title="LOT 현황 조회" Icon="file" />

<div class="pm-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <input class="form-control" style="max-width:320px" placeholder="LOT번호 / S/N / 반출번호" @bind="_keyword" @bind:event="oninput" @onkeyup="OnKeyUp" />
    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_busy">조회</button>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger py-2">@_loadError</div>
}

@if (_notFound)
{
    <div class="alert alert-warning">해당하는 LOT을 찾을 수 없습니다.</div>
}

@if (_header is not null)
{
    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-3">
            @* LOT QR: 라벨로 인쇄해 붙이면 OPER 화면·LOT 스캔에서 찍어 바로 찾을 수 있다(값 = LOT 번호). *@
            @if (_qrSrc is not null)
            {
                <div class="text-center order-md-last">
                    <img src="@_qrSrc" alt="LOT QR" width="120" height="120" />
                    <div class="small text-muted">LOT QR (라벨·스캔용)</div>
                </div>
            }
            <div class="row flex-grow-1" style="min-width:0">
                <div class="col-md-6">
                    <div><span class="text-muted">LOT 번호</span> <strong>@_header.LotNumber</strong></div>
                    <div><span class="text-muted">S/N</span> @_header.SerialNumber</div>
                    <div><span class="text-muted">반출번호</span> @_header.ExportNumber</div>
                    <div><span class="text-muted">MAT ID</span> @_header.MatId · @_header.MatDesc</div>
                </div>
                <div class="col-md-6">
                    <div><span class="text-muted">고객사</span> @_header.CustomerName</div>
                    <div><span class="text-muted">LINE</span> @_header.Line</div>
                    <div><span class="text-muted">현재 공정</span> @_header.CurrentOperCode · @_header.CurrentOperName</div>
                    <div><span class="text-muted">코멘트</span> @_header.Comment</div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5 mb-2">TRAN 이력</h2>
    <div class="table-responsive pm-table-scroll pm-table-scroll-sm">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr><th>OPER</th><th>공정</th><th>TRAN</th><th>시각</th><th class="text-end">수량</th><th>레시피</th><th>설비</th><th>사유</th><th>작업자</th></tr>
            </thead>
            <tbody>
                @foreach (var t in _transitions)
                {
                    <tr>
                        <td>@t.OperCode</td>
                        <td>@t.OperDesc</td>
                        <td>@t.TranCode</td>
                        <td>@t.TranTime.ToString("MM-dd HH:mm")</td>
                        <td class="text-end">@t.Quantity</td>
                        <td>@t.RecipeId</td>
                        <td>@t.ResId</td>
                        <td>@t.TranCause</td>
                        <td>@t.UserId</td>
                    </tr>
                }
                @if (_transitions.Count == 0)
                {
                    <EmptyRow Colspan="9" Message="이력이 없습니다." />
                }
            </tbody>
        </table>
    </div>

    <div class="pm-split pm-split-5-7 mt-3 pm-grow">
        @* 앱 LotStatusView 좌측 하단: 같은 S/N의 입고~출고 사이클 누적 *@
        <div class="pm-grow-col">
            <h2 class="h6 mb-2">입고/출고 사이클 (S/N 기준 누적)</h2>
            <div class="table-responsive pm-table-scroll pm-table-scroll-sm">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>NO</th><th>입고일자</th><th>출고일자</th><th>비고</th></tr></thead>
                    <tbody>
                        @foreach (var c in _cycles)
                        {
                            <tr>
                                <td>@c.No</td>
                                <td>@c.InboundDate.ToString("yyyy-MM-dd")</td>
                                <td>@(c.OutboundDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@c.Remarks</td>
                            </tr>
                        }
                        @if (_cycles.Count == 0){ <EmptyRow Colspan="4" Message="기록이 없습니다." /> }
                    </tbody>
                </table>
            </div>
        </div>

        @* 앱 LotStatusView 우측 하단: 파라미터 측정값 기록 *@
        <div class="pm-grow-col">
            <h2 class="h6 mb-2">파라미터 적용 값</h2>
            <div class="table-responsive pm-table-scroll pm-table-scroll-sm">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr><th>OPER</th><th>공정</th><th>PARAMETER</th><th>DESC</th><th>값</th><th>코멘트</th><th>기록시각</th></tr></thead>
                    <tbody>
                        @foreach (var p in _paramRecords)
                        {
                            <tr>
                                <td>@p.OperCode</td>
                                <td>@p.OperDesc</td>
                                <td>@p.ParameterCode</td>
                                <td>@p.ParameterDescription</td>
                                <td>@p.InputValue</td>
                                <td>@p.Comment</td>
                                <td>@p.RecordedAt.ToString("MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (_paramRecords.Count == 0){ <EmptyRow Colspan="7" Message="기록이 없습니다." /> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    // OPER 목록의 "현황" 링크(/history?lot=LOT번호)로 바로 조회되게 한다.
    [SupplyParameterFromQuery(Name = "lot")] public string? LotQuery { get; set; }
    private string? _qrSrc;

    private string? _keyword;
    private bool _busy;
    private bool _notFound;
    private string? _loadError;
    private string? _lastLotQuery;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(LotQuery) && LotQuery != _lastLotQuery)
        {
            _lastLotQuery = LotQuery;
            _keyword = LotQuery;
            await SearchAsync();
        }
    }
    private LotHistoryHeaderDto? _header;
    private IReadOnlyList<LotTransitionRowDto> _transitions = Array.Empty<LotTransitionRowDto>();
    private IReadOnlyList<LotCycleRowDto> _cycles = Array.Empty<LotCycleRowDto>();
    private IReadOnlyList<LotParameterRecordDto> _paramRecords = Array.Empty<LotParameterRecordDto>();

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private Task SearchAsync() => Gate.RunAsync(SearchCoreAsync);

    private async Task SearchCoreAsync()
    {
        _busy = true;
        _loadError = null;
        _notFound = false;
        _header = null;
        _transitions = Array.Empty<LotTransitionRowDto>();
        _cycles = Array.Empty<LotCycleRowDto>();
        _paramRecords = Array.Empty<LotParameterRecordDto>();
        try
        {
            var lotId = await HistoryService.FindLotIdByKeywordAsync(string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim());
            if (lotId is null) { _notFound = true; return; }

            _header = await HistoryService.GetHeaderAsync(lotId.Value);
            _qrSrc = $"data:image/png;base64,{Convert.ToBase64String(Barcodes.EncodeQrPng(_header.LotNumber))}";
            _transitions = await HistoryService.GetTransitionsBySerialNumberAsync(_header.SerialNumber);
            _cycles = await HistoryService.GetCyclesBySerialNumberAsync(_header.SerialNumber);
            _paramRecords = await HistoryService.GetParameterRecordsBySerialNumberAsync(_header.SerialNumber);
        }
        catch (Exception ex) { _loadError = UiErrors.ToMessage(ex, Logger, "LOT 현황 조회"); }
        finally { _busy = false; }
    }
}
