@page "/change-password"
@attribute [Authorize]
@layout ProductionManagement.Web.Components.Layout.AuthLayout

<PageTitle>비밀번호 변경 · Production MES</PageTitle>

@* 최초 로그인 비밀번호 변경(2026-09-15 웹 QA #2, 앱의 비밀번호 변경 창과 같은 역할).
   관리자가 만든 계정·초기화한 비밀번호(MustChangePassword)는 이 화면에서 새 비밀번호로 바꿔야 다른 화면을 쓸 수 있다
   (Program.cs 미들웨어가 막음). 폼은 /auth/change-password로 POST하고, 성공하면 쿠키를 새로 발급한다. *@

<div class="card pm-auth-card">
    <div class="card-body p-4 p-sm-5">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="pm-auth-mark"><NavIcon Name="factory" Size="26" /></span>
            <div>
                <div class="fw-bold fs-5 lh-sm">Production MES</div>
                <div class="text-muted small">생산관리 시스템</div>
            </div>
        </div>

        <h1 class="h5 fw-bold mb-1">비밀번호 변경</h1>
        <p class="text-muted small mb-4">처음 로그인했거나 관리자가 비밀번호를 초기화했습니다. 계속하려면 새 비밀번호로 바꿔 주세요.</p>

        @if (ErrorText is not null)
        {
            <div class="alert alert-danger py-2 small">@ErrorText</div>
        }

        <form method="post" action="/auth/change-password">
            <div class="mb-3">
                <label class="form-label small" for="pw-current">현재 비밀번호</label>
                <input id="pw-current" class="form-control pm-input-lg" type="password" name="currentPassword" autocomplete="current-password" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label small" for="pw-new">새 비밀번호 (4자 이상)</label>
                <input id="pw-new" class="form-control pm-input-lg" type="password" name="newPassword" autocomplete="new-password" />
            </div>
            <div class="mb-4">
                <label class="form-label small" for="pw-confirm">새 비밀번호 확인</label>
                <input id="pw-confirm" class="form-control pm-input-lg" type="password" name="confirmPassword" autocomplete="new-password" />
            </div>
            <button class="btn btn-primary w-100 pm-input-lg" type="submit">변경하고 계속</button>
        </form>

        <form method="post" action="/auth/logout" class="text-center mt-3">
            <button type="submit" class="btn btn-link btn-sm">다른 계정으로 로그인</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string? ErrorText => Error switch
    {
        "current" => "현재 비밀번호가 올바르지 않습니다.",
        "mismatch" => "새 비밀번호와 확인 값이 다릅니다.",
        "length" => "새 비밀번호는 4자 이상이어야 합니다.",
        "same" => "현재 비밀번호와 다른 값으로 정해 주세요.",
        _ => null
    };
}
