@inherits SetupTabBase
@inject ICustomerService CustomerService
@inject IProductReferenceDataService RefData

@* 셋업 > 업체 관리 (앱 CustomerManagementView / CustomerManagementViewModel).
   업체는 과거 LOT·제품이 참조하므로 삭제 없이 중지로만 다룬다.
   LINE은 업체가 속한 대분류로, 제품 셋업의 기본 LINE과는 별개다.
   앱의 행 ⋮ 메뉴(중지/활성화)는 웹에서 [작업] 열 버튼으로 바로 보인다. *@

<div class="row g-3">
    <div class="col-lg-8">
        <div class="pm-section-title">업체 목록</div>
        <div class="input-group input-group-sm mb-2">
            <input class="form-control" placeholder="업체명 / 코드로 검색" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
            <span class="input-group-text">@_filtered.Count 건</span>
        </div>
        <div class="pm-scroll pm-fill">
            <table class="table table-sm table-hover pm-clickable align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:140px">업체 코드</th>
                        <th>업체명</th>
                        <th style="width:90px">LINE</th>
                        <th style="width:80px" class="text-center">상태</th>
                        <th style="width:90px" class="text-center">작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in _filtered)
                    {
                        <tr @key="customer.CustomerId" class="@(customer.CustomerId == _selected?.CustomerId ? "table-primary" : "")" @onclick="() => Select(customer)">
                            <td>@customer.CustomerCode</td>
                            <td>@customer.CustomerName</td>
                            <td>@(customer.LineCode ?? "-")</td>
                            <td class="text-center"><ActiveBadge IsActive="customer.IsActive" /></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => ToggleActiveAsync(customer)" @onclick:stopPropagation="true">
                                    @(customer.IsActive ? "중지" : "활성화")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_filtered.Count == 0)
            {
                <div class="pm-empty">등록된 업체가 없습니다.</div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="pm-section-title">@(_isEditingNew ? "업체 등록" : "업체 수정")</div>
        <div class="card shadow-sm">
            <div class="card-body">
                <label class="form-label small mb-0">업체 코드</label>
                <input class="form-control form-control-sm mb-3" @bind="_code" @bind:event="oninput" />

                <label class="form-label small mb-0">업체명</label>
                <input class="form-control form-control-sm mb-3" @bind="_name" @bind:event="oninput" />

                <label class="form-label small mb-0">반출번호 약어</label>
                <input class="form-control form-control-sm mb-3" @bind="_prefix" @bind:event="oninput" />

                <label class="form-label small mb-0">LINE</label>
                <select class="form-select form-select-sm mb-3" @bind="_lineId">
                    <option value="">-</option>
                    @foreach (var line in _lines)
                    {
                        <option value="@line.LineId">@line.Description</option>
                    }
                </select>

                <StatusText Message="@_status" IsError="_isError" Class="mb-3" />

                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NewForm">새로 작성</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_busy">저장</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<CustomerDto> _all = Array.Empty<CustomerDto>();
    private List<CustomerDto> _filtered = new();
    private IReadOnlyList<LineOptionDto> _lines = Array.Empty<LineOptionDto>();
    private string _search = string.Empty;

    private CustomerDto? _selected;
    private bool _isEditingNew = true, _busy, _isError;
    private string _code = string.Empty, _name = string.Empty, _prefix = string.Empty;
    private int? _lineId;
    private string? _status;

    protected override Task OnInitializedAsync() => Gate.RunAsync(async () =>
    {
        var error = await TryAsync(async () =>
        {
            _lines = await RefData.GetLinesAsync();
            await LoadAsync();
        }, "업체 목록을 불러오는 중 문제가 발생했습니다.");
        if (error is not null)
        {
            SetStatus(error, true);
        }
    });

    private async Task LoadAsync()
    {
        _all = await CustomerService.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var keyword = _search.Trim();
        _filtered = keyword.Length == 0
            ? _all.ToList()
            : _all.Where(c => Has(c.CustomerName, keyword) || Has(c.CustomerCode, keyword)).ToList();
    }

    private void SetStatus(string? message, bool isError)
    {
        _status = message;
        _isError = isError;
    }

    private void NewForm()
    {
        _selected = null;
        _code = _name = _prefix = string.Empty;
        _lineId = null;
        _isEditingNew = true;
        SetStatus(null, false);
    }

    private void Select(CustomerDto customer)
    {
        _selected = customer;
        _code = customer.CustomerCode;
        _name = customer.CustomerName;
        _prefix = customer.ExportPrefix;
        _lineId = customer.LineDefinitionId is { } lineId && _lines.Any(l => l.LineId == lineId) ? lineId : null;
        _isEditingNew = false;
        SetStatus(null, false);
    }

    private Task SaveAsync() => Gate.RunAsync(async () =>
    {
        _busy = true;
        try
        {
            var isNew = _isEditingNew || _selected is null;
            var editingId = _selected?.CustomerId;
            var request = new CustomerUpsertRequest(_code.Trim(), _name.Trim(), _prefix.Trim(), _lineId);
            var error = await TryAsync(async () =>
            {
                if (isNew)
                {
                    await CustomerService.CreateAsync(request);
                }
                else
                {
                    await CustomerService.UpdateAsync(editingId!.Value, request);
                }
                await LoadAsync();
            }, "저장 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요.");

            if (error is not null)
            {
                SetStatus(error, true);
                return;
            }

            NewForm();
            SetStatus("저장되었습니다.", false);
        }
        finally
        {
            _busy = false;
        }
    });

    private Task ToggleActiveAsync(CustomerDto customer) => Gate.RunAsync(async () =>
    {
        var error = await TryAsync(async () =>
        {
            await CustomerService.SetActiveAsync(customer.CustomerId, !customer.IsActive);
            await LoadAsync();
        }, "상태 변경 중 문제가 발생했습니다.");
        if (error is not null)
        {
            SetStatus(error, true);
            return;
        }

        if (_selected?.CustomerId == customer.CustomerId)
        {
            _selected = _all.FirstOrDefault(c => c.CustomerId == customer.CustomerId);
        }
        SetStatus($"'{customer.CustomerName}' 업체를 {(customer.IsActive ? "중지" : "활성화")}했습니다.", false);
    });
}
